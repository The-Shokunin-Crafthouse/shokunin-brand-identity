# ============================================================
# .gitignore — Shokunin Crafthouse project template
# ============================================================

# dependencies
node_modules/
.pnp
.pnp.js
.yarn/
.pnpm-store/

# build outputs
.next/
.turbo/
.svelte-kit/
.astro/
dist/
build/
out/

# testing / coverage
coverage/
.nyc_output/
playwright-report/
test-results/

# env files — never commit
.env
.env.*
!.env.example

# secrets
secrets/
*.key
*.pem
*.p12
*.mobileprovision
*.keystore
credentials.json
service-account*.json

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# deploy artifacts
.vercel/
.netlify/
.wrangler/

# caches
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# Figma bulk exports (keep structure, not assets)
stages/02-design/figma/exports/

# model-local artifacts
.claude-cache/
.cursor-cache/
.ai-cache/
dist-lib/

# design-sync (claude.ai/design) — staged scripts, build output, machine state
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# plusfield-to-figma — regenerated by scripts/plusfield-to-figma.mjs (manifest.json is committed)
stages/02-design/figma/plusfield/svg/

# sc-tune: raw lab exports (the record folder keeps spec.json)
output/tuning/.exports/
