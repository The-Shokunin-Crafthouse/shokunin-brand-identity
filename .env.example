# ============================================================
# .env.example — copy to .env and fill in. .env is gitignored.
# ============================================================

# Figma personal access token — used by `npm run figma:publish`
# (figma connect publish) to write Code Connect mappings into the
# SCDS Figma file. NEVER commit the real token.
#
# Generate: Figma → Settings → Security → Personal access tokens →
#   Generate new token. Required scopes:
#     • Code Connect — Write
#     • File content  — Read
#
# `npm run figma:parse` (the local dry check) does NOT need this token.
FIGMA_ACCESS_TOKEN=
